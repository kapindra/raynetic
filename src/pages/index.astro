---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const blogPosts = await getCollection('blog');
const latestPosts = blogPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const stats = [
  { value: 22, suffix: '+', label: 'Projects Delivered' },
  { value: 98, suffix: '%', label: 'Client Satisfaction' },
  { value: 150, suffix: '%', label: 'Average ROI Increase' },
  { value: 24, suffix: '/7', label: 'Project Support' }
];

const processSteps = [
  { num: '01', title: 'Strategic Discovery', desc: 'We analyze your search keyword intent, competitor landscape, and brand objectives.' },
  { num: '02', title: 'Bespoke Blueprint', desc: 'We present a customized visual mockup, feature scope, and traffic campaign strategy.' },
  { num: '03', title: 'Agile Build Sprints', desc: 'We engineer responsive layouts, high-performance codebases, and brand assets.' },
  { num: '04', title: 'Launch & Optimize', desc: 'We deploy marketing campaigns, monitor analytics, and scale customer conversions.' }
];

const testimonials = [
  {
    quote: "Raynetic transformed our online sales. Their targeted search campaigns and conversion optimization resolved customer drop-offs that plagued our platform for years. The team is responsive, and sales increased by 140% in four months.",
    author: "Sarah Jenkins",
    role: "Chief Operations Officer",
    rating: 5
  },
  {
    quote: "Our custom e-commerce web platform was a complex project. Raynetic engineered a headless WordPress system, optimized our mobile application, and managed the deployment with zero downtime. Exceptional partners.",
    author: "David Chen",
    role: "VP of Engineering",
    rating: 5
  },
  {
    quote: "Launching our brand identity and mobile app seemed daunting. Raynetic designed a human-centric visual interface, optimized our search visibility, and ran high-converting campaign flows. Invaluable.",
    author: "Dr. Elena Rostova",
    role: "Director",
    rating: 5
  }
];

const partners = [
  { name: 'Microsoft Partner', path: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z' },
  { name: 'AWS Certified', path: 'M12 2L2 22h20L12 2zm0 3.3L19.7 19H4.3L12 5.3z' },
  { name: 'ISO 27001 Security', path: 'M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z' },
  { name: 'Essential Eight', path: 'M12 22c5.52 0 10-4.48 10-10S17.52 2 12 2 2 6.48 2 12s4.48 10 10 10zm-1-15h2v6h-2V7zm0 8h2v2h-2v-2z' }
];
---

<BaseLayout 
  title="Raynetic Solutions — Custom Design, Development & Marketing Solutions"
  description="Raynetic Solutions is a premium digital agency providing web design and development, custom mobile applications, UI/UX design, graphics design, and digital marketing."
>
  
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center pt-24 pb-16 overflow-hidden">
    <!-- Animated background mesh -->
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="absolute inset-0 dot-grid opacity-30 pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto px-4 md:px-8 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
      <!-- Hero Left Text -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-accent/10 border border-accent/20 rounded-full text-xs text-accent font-mono animate-fade-up">
          <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
          Custom Design, Development & Marketing Partner
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white leading-tight animate-fade-up delay-100">
          Where Technology<br />
          Meets <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-2">Results</span>.
        </h1>
        <p class="text-base sm:text-lg text-text-muted max-w-xl animate-fade-up delay-200">
          We design, build, and optimize the high-converting websites, mobile apps, and digital campaigns that drive growth for ambitious businesses globally.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 pt-4 animate-fade-up delay-300">
          <a href="/contact" class="px-8 py-4 bg-accent hover:bg-accent/80 text-bg font-sans font-bold rounded-xl transition-all shadow-glow hover:shadow-hover text-center">
            Get a Free Consultation &rarr;
          </a>
          <a href="#services" class="px-8 py-4 border border-border hover:border-accent/40 text-white font-sans font-semibold rounded-xl transition-all text-center">
            Explore Services &darr;
          </a>
        </div>
      </div>
      
      <!-- Hero Right Graphics -->
      <div class="lg:col-span-5 relative hidden lg:block animate-fade-up delay-300" data-parallax="0.1">
        <!-- Glowing background shadows -->
        <div class="absolute -inset-4 bg-radial-gradient from-accent/20 to-transparent blur-xl pointer-events-none"></div>
        
        <!-- Clean viewport for Vector Graphics -->
        <div class="relative w-full aspect-square max-w-[580px] flex items-center justify-center">
          <!-- Animated Minimal SVG Tech Constellation / Cloud Orchestration -->
          <svg viewBox="0 0 500 500" class="w-full h-full text-accent" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <!-- Core Gradient -->
              <linearGradient id="core-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="var(--color-accent)" />
                <stop offset="100%" stop-color="var(--color-accent-2)" />
              </linearGradient>
              <!-- Radial Glow -->
              <radialGradient id="glow-grad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.25" />
                <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0" />
              </radialGradient>
              <!-- Drop Shadow Filter for Badges (popping in Light Theme) -->
              <filter id="badge-shadow" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="4" stdDeviation="5" flood-color="#0F172A" flood-opacity="0.12" />
              </filter>
            </defs>

            <!-- Background Pulsing Glow -->
            <circle cx="250" cy="250" r="180" fill="url(#glow-grad)" class="animate-pulse [animation-duration:5s]" />

            <!-- Outer Orbit Ring (Slow rotation) -->
            <circle cx="250" cy="250" r="180" stroke="currentColor" stroke-width="1.2" stroke-opacity="0.15" stroke-dasharray="10 20" class="animate-[spin_45s_linear_infinite]" style="transform-origin: 250px 250px;" />

            <!-- Middle Orbit Ring (Reverse rotation) -->
            <circle cx="250" cy="250" r="140" stroke="var(--color-accent-2)" stroke-width="1.2" stroke-opacity="0.2" stroke-dasharray="6 12" class="animate-[spin_30s_linear_infinite_reverse]" style="transform-origin: 250px 250px;" />

            <!-- Inner Orbit Ring -->
            <circle cx="250" cy="250" r="100" stroke="currentColor" stroke-width="1" stroke-opacity="0.15" stroke-dasharray="4 8" class="animate-[spin_20s_linear_infinite]" style="transform-origin: 250px 250px;" />

            <!-- Isometric Connectivity Constellation Grid -->
            <g class="opacity-40 text-text-muted">
              <!-- Grid Lines -->
              <line x1="250" y1="120" x2="350" y2="180" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" />
              <line x1="250" y1="120" x2="150" y2="180" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" />
              <line x1="350" y1="180" x2="350" y2="300" stroke="currentColor" stroke-width="1" />
              <line x1="150" y1="180" x2="150" y2="300" stroke="currentColor" stroke-width="1" />
              <line x1="350" y1="300" x2="250" y2="360" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" />
              <line x1="150" y1="300" x2="250" y2="360" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" />
              <line x1="250" y1="120" x2="250" y2="360" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.3" />
              <line x1="150" y1="180" x2="250" y2="240" stroke="currentColor" stroke-width="1" />
              <line x1="350" y1="180" x2="250" y2="240" stroke="currentColor" stroke-width="1" />
              <line x1="250" y1="240" x2="250" y2="360" stroke="var(--color-accent-2)" stroke-width="1.5" />
            </g>

            <!-- Active Pulsing Nodes -->
            <!-- Node A: Top -->
            <circle cx="250" cy="120" r="5" fill="url(#core-grad)" />
            <circle cx="250" cy="120" r="12" stroke="currentColor" stroke-width="1" stroke-opacity="0.4" class="animate-ping" style="transform-origin: 250px 120px;" />

            <!-- Node B: Center Hub -->
            <circle cx="250" cy="240" r="7" fill="url(#core-grad)" />
            <circle cx="250" cy="240" r="16" stroke="var(--color-accent-2)" stroke-width="1" stroke-opacity="0.4" class="animate-ping" style="transform-origin: 250px 240px; animation-duration: 2.5s;" />

            <!-- Node C: Right Bottom -->
            <circle cx="350" cy="300" r="4.5" fill="currentColor" />
            <!-- Node D: Left Bottom -->
            <circle cx="150" cy="300" r="4.5" fill="currentColor" />
            <!-- Node E: Bottom Center -->
            <circle cx="250" cy="360" r="5" fill="url(#core-grad)" />

            <!-- Flowing Data Signals -->
            <!-- Top to Center Hub -->
            <circle cx="250" cy="120" r="2.5" fill="var(--color-accent-warm)">
              <animateMotion dur="4s" repeatCount="indefinite" path="M0,0 L0,120" />
            </circle>
            <!-- Left to Center Hub -->
            <circle cx="150" cy="180" r="2.5" fill="currentColor">
              <animateMotion dur="3s" repeatCount="indefinite" path="M0,0 L100,60" />
            </circle>
            <!-- Right to Center Hub -->
            <circle cx="350" cy="180" r="2.5" fill="currentColor">
              <animateMotion dur="3.2s" repeatCount="indefinite" path="M0,0 L-100,60" />
            </circle>

            <!-- Revolving Tech Tool Badges (Orbiting Satellites) -->
            <!-- ORBIT 1 (Outer, Radius 180): AWS, Azure, Terraform, & GitHub -->
            <g class="animate-[spin_40s_linear_infinite]" style="transform-origin: 250px 250px;">
              <!-- AWS Cloud Badge at top (250, 70) -->
              <g transform="translate(250, 70)" filter="url(#badge-shadow)">
                <circle r="26" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.5" />
                <path d="M-5,2 a3,3 0 0,1 0,-6 a4.5,4.5 0 0,1 8,-1 a3,3 0 0,1 1,5 z" fill="var(--color-accent)" transform="scale(1.5)" />
              </g>
              <!-- Azure Diamond Badge at right (430, 250) -->
              <g transform="translate(430, 250)" filter="url(#badge-shadow)">
                <circle r="25" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.5" />
                <path d="M-5,4 L0,-6 L5,-1 L-1,4 Z" fill="var(--color-accent-2)" transform="scale(1.4)" />
              </g>
              <!-- Terraform Blocks Badge at bottom (250, 430) -->
              <g transform="translate(250, 430)" filter="url(#badge-shadow)">
                <circle r="24" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.5" />
                <g fill="var(--color-accent-2)" transform="scale(1.2)">
                  <rect x="-6" y="-6" width="5" height="5" rx="0.8" />
                  <rect x="-6" y="1" width="5" height="5" rx="0.8" />
                  <rect x="0" y="-2.5" width="5" height="5" rx="0.8" />
                  <rect x="6" y="-6" width="5" height="5" rx="0.8" />
                </g>
              </g>
              <!-- GitHub Octocat Badge at left (70, 250) -->
              <g transform="translate(70, 250)" filter="url(#badge-shadow)">
                <circle r="24" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.5" />
                <g fill="var(--color-accent-warm)" transform="scale(1.3) translate(0, -1)">
                  <circle cx="0" cy="1" r="5" fill="currentColor" />
                  <path d="M-4,-3 L-5,-7 L-1,-4 Z M4,-3 L5,-7 L1,-4 Z" fill="currentColor" />
                  <path d="M-3,5 Q0,8 3,5" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/>
                </g>
              </g>
            </g>

            <!-- ORBIT 2 (Middle, Radius 140): Kubernetes, Docker, Metrics, & Systems -->
            <g class="animate-[spin_28s_linear_infinite_reverse]" style="transform-origin: 250px 250px;">
              <!-- Monitoring/Metrics Badge at top (250, 110) -->
              <g transform="translate(250, 110)" filter="url(#badge-shadow)">
                <circle r="22" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.5" />
                <g fill="var(--color-accent-warm)" transform="scale(1.35) translate(-1, -1)">
                  <rect x="-6" y="-2" width="3" height="7" rx="0.5" />
                  <rect x="-1" y="-5" width="3" height="10" rx="0.5" />
                  <rect x="4" y="1" width="3" height="4" rx="0.5" />
                </g>
              </g>
              <!-- Kubernetes Wheel Badge at left (110, 250) -->
              <g transform="translate(110, 250)" filter="url(#badge-shadow)">
                <circle r="24" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.5" />
                <g stroke="var(--color-accent)" stroke-width="1.4" fill="none" transform="scale(1.4)">
                  <path d="M0,-7 L6,-3.5 L6,3.5 L0,7 L-6,3.5 L-6,-3.5 Z" />
                  <circle cx="0" cy="0" r="1.8" fill="var(--color-accent)" />
                  <line x1="0" y1="0" x2="0" y2="-7" />
                  <line x1="0" y1="0" x2="5.2" y2="3" />
                  <line x1="0" y1="0" x2="-5.2" y2="3" />
                </g>
              </g>
              <!-- Docker Whale Badge at right (390, 250) -->
              <g transform="translate(390, 250)" filter="url(#badge-shadow)">
                <circle r="22" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.5" />
                <g fill="var(--color-accent-2)" transform="scale(1.25) translate(-1, -1)">
                  <rect x="-6" y="-4" width="3" height="2" rx="0.5" />
                  <rect x="-2" y="-4" width="3" height="2" rx="0.5" />
                  <rect x="2" y="-4" width="3" height="2" rx="0.5" />
                  <rect x="-4" y="-1.5" width="3" height="2" rx="0.5" />
                  <rect x="0" y="-1.5" width="3" height="2" rx="0.5" />
                  <path d="M-6,2.5 c0,0 4,2 8,0 c0,0 1,-1.5 0.5,-2 c-1,-1 -8.5,-0.5 -8.5,2 z" />
                </g>
              </g>
              <!-- Systems Console Badge at bottom (250, 390) -->
              <g transform="translate(250, 390)" filter="url(#badge-shadow)">
                <circle r="21" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.5" />
                <g stroke="var(--color-accent)" stroke-width="1.5" fill="none" transform="scale(1.35) translate(-1, -1)">
                  <path d="M-5,-4 L-1,0 L-5,4" stroke-linecap="round" stroke-linejoin="round" />
                  <line x1="1" y1="4" x2="7" y2="4" stroke-width="2" stroke-linecap="round" stroke="var(--color-accent)" />
                </g>
              </g>
            </g>

            <!-- ORBIT 3 (Inner, Radius 100): Git & Code -->
            <g class="animate-[spin_18s_linear_infinite]" style="transform-origin: 250px 250px;">
              <!-- Git Node Badge at top-inner (250, 150) -->
              <g transform="translate(250, 150)" filter="url(#badge-shadow)">
                <circle r="21" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.5" />
                <g stroke="var(--color-accent-warm)" stroke-width="1.4" fill="none" transform="scale(1.35)">
                  <circle cx="-2" cy="-3.5" r="1.5" fill="var(--color-accent-warm)" />
                  <circle cx="-2" cy="3.5" r="1.5" fill="var(--color-accent-warm)" />
                  <circle cx="3.5" cy="0" r="1.5" fill="var(--color-accent-warm)" />
                  <path d="M-2,-2 L-2,2 M-2,0 Q1,0 2,0" />
                </g>
              </g>
              <!-- Code Tags Badge at bottom-inner (250, 350) -->
              <g transform="translate(250, 350)" filter="url(#badge-shadow)">
                <circle r="20" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.5" />
                <g stroke="var(--color-accent-2)" stroke-width="1.5" stroke-linecap="round" fill="none" transform="scale(1.3)">
                  <path d="M-4,-3.5 L-7,0 L-4,3.5 M4,-3.5 L7,0 L4,3.5 M-1.5,4 L1.5,-4" />
                </g>
              </g>
            </g>
          </svg>
        </div>
      </div>
    </div>

    <!-- Animated Chevron Cue -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 opacity-70">
      <span class="text-[10px] font-mono tracking-widest text-text-muted uppercase">Scroll</span>
      <svg class="w-4 h-4 text-accent animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- Section 2: Trust Marquee -->
  <section class="py-12 border-t border-b border-border bg-bg-2 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <p class="text-center text-xs uppercase tracking-widest text-text-faint font-mono font-bold mb-8">
        Aligned with Industry Standards & Top Platforms
      </p>
      
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-16">
        {partners.map(partner => (
          <div class="flex items-center gap-3 text-text-muted hover:text-accent transition-colors cursor-pointer group">
            <svg class="w-6 h-6 stroke-current text-text-faint group-hover:text-accent transition-colors" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={partner.path} />
            </svg>
            <span class="text-sm font-mono font-bold">{partner.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Services Overview -->
  <section id="services" class="py-24 border-b border-border scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      
      <!-- Section Header -->
      <div class="max-w-3xl mb-16 space-y-4 reveal">
        <span class="text-xs uppercase tracking-widest text-accent font-mono font-bold">What We Do</span>
        <h2 class="text-3xl md:text-5xl font-bold text-white">Digital Design & Development Solutions</h2>
        <p class="text-text-muted">
          From custom web and mobile app development to strategic UI/UX design, brand identity, and data-driven marketing, we deliver premium solutions that accelerate business growth online.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedServices.map(service => (
          <div class="gradient-border-card p-8 border border-border flex flex-col justify-between h-full hover-glow reveal">
            <div class="space-y-6">
              <div class="p-3 bg-accent/10 text-accent rounded-xl w-fit">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={service.data.icon} />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">{service.data.title}</h3>
              <p class="text-sm text-text-muted">{service.data.excerpt}</p>
            </div>
            <div class="pt-8">
              <a href={`/services/${service.id}`} class="text-sm font-mono text-accent hover:underline flex items-center gap-1">
                Learn more &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: Stats Counter -->
  <section class="py-20 bg-bg-2 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {stats.map(stat => (
          <div class="space-y-2 reveal">
            <div class="text-4xl sm:text-5xl font-bold text-white font-mono flex items-center justify-center">
              <span class="counter-number" data-target={stat.value}>0</span>{stat.suffix}
            </div>
            <p class="text-xs sm:text-sm text-text-muted font-mono uppercase tracking-wider">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 5: Why Choose Us (USP) -->
  <section class="py-24 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      
      <!-- USP Left Text -->
      <div class="lg:col-span-6 space-y-6 reveal">
        <span class="text-xs uppercase tracking-widest text-accent font-mono font-bold">Why Choose Us</span>
        <h2 class="text-3xl md:text-5xl font-bold text-white">The Raynetic Solutions Difference</h2>
        <p class="text-lg text-text-muted leading-relaxed">
          We act as a strategic expansion of your team, providing transparent flat-rate pricing models, experienced local managers, and high-performance digital strategies.
        </p>

        <div class="space-y-4 pt-4">
          <div class="flex items-start gap-4">
            <div class="flex items-center justify-center w-6 h-6 bg-accent/20 text-accent rounded-full flex-shrink-0 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h4 class="text-base font-bold text-white">Predictable Scope & Retainer Pricing</h4>
              <p class="text-base text-text-muted mt-1">No surprise consulting rates or hidden agency fees. We provide clear, value-driven scopes tailored to your budget constraints.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="flex items-center justify-center w-6 h-6 bg-accent/20 text-accent rounded-full flex-shrink-0 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h4 class="text-base font-bold text-white">Dedicated Brisbane Brand Managers</h4>
              <p class="text-base text-text-muted mt-1">Direct contact numbers to designers, developers, and copywriters who lead your project from concept to launch.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="flex items-center justify-center w-6 h-6 bg-accent/20 text-accent rounded-full flex-shrink-0 mt-1">
