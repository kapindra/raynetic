---
import BaseLayout from '../layouts/BaseLayout.astro';

const values = [
  { name: 'Integrity First', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', desc: 'We maintain absolute transparency. We do not lock clients into complex proprietary contracts and provide clear, flat-rate pricing details.' },
  { name: 'Continuous Innovation', icon: 'M13 10V3L4 14h7v7l9-11h-7z', desc: 'We proactively adopt next-generation public cloud, automation tools, and security standards to keep our clients ahead of operational curves.' },
  { name: 'SLA Accountability', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', desc: 'Uptime is our core metric. We measure our success on resolution speed and proactivity, backed by strict financial SLA commitments.' },
  { name: 'Genuine Partnership', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z', desc: 'We act as an integrated extension of your business operations. Your dedicated account manager ensures regular strategic alignment.' }
];

const team = [
  { name: 'Marcus Rayn', title: 'Managing Director & Founder', initials: 'MR' },
  { name: 'Elena Rostova', title: 'VP of Engineering', initials: 'ER' },
  { name: 'Thomas Vance', title: 'Director of Security Operations', initials: 'TV' },
  { name: 'Sarah Jenkins', title: 'Client Operations Lead', initials: 'SJ' }
];

const timeline = [
  { year: '2018', title: 'Raynatic Solutions Founded', desc: 'Established in Melbourne with a mission to deliver transparent, flat-rate IT services for mid-market firms.' },
  { year: '2020', title: 'First 50 Managed Clients', desc: 'Expanded our operations team and built our proactive Network Operations Center (NOC) in Collins Street.' },
  { year: '2022', title: 'Cloud Automation Launch', desc: 'Integrated automated DevOps, containerization, and Infrastructure as Code into our default service stack.' },
  { year: '2024', title: 'ISO 27001 Compliance', desc: 'Formally aligned our entire organization and helpdesk infrastructure to certified international security standards.' }
];

const awards = [
  { name: 'Microsoft Gold Partner', desc: 'Cloud Platform Specialization' },
  { name: 'AWS Advanced Partner', desc: 'DevOps & Migration Specialization' },
  { name: 'ISO 27001 Certified', desc: 'Information Security Management' },
  { name: 'ACSC Essential Eight', desc: 'Maturity Level 3 Alignment' }
];
---

<BaseLayout 
  title="About Us — Raynatic Solutions"
  description="Discover the history, values, team, and security compliance records that make Raynatic Solutions the preferred IT outsourcing partner in Melbourne."
>
  
  <!-- About Hero -->
  <section class="relative pt-32 pb-20 border-b border-border">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10 text-center space-y-6">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center justify-center gap-2 text-xs font-mono text-text-muted">
        <a href="/" class="hover:text-accent">Home</a>
        <span>/</span>
        <span class="text-white">About Us</span>
      </nav>
      
      <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight">
        About Raynatic Solutions
      </h1>
      <p class="text-base sm:text-lg text-text-muted max-w-2xl mx-auto">
        Building high-performance, secure digital foundations for Australian businesses since 2018.
      </p>
    </div>
  </section>

  <!-- Section 1: Company Story -->
  <section class="py-24 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-16">
      
      <!-- Story Title -->
      <div class="lg:col-span-4 space-y-4 reveal">
        <span class="text-xs uppercase tracking-widest text-accent font-mono font-bold">Our Story</span>
        <h2 class="text-3xl font-bold text-white">How We Started</h2>
      </div>

      <!-- Story Content -->
      <div class="lg:col-span-8 space-y-6 text-sm text-text-muted leading-relaxed reveal">
        <p>
          Raynatic Solutions was founded in Melbourne by Marcus Rayn after years of witnessing growing organizations struggle with the traditional "break-fix" consulting model. Too often, IT firms profited from their clients' technical failures, charging high hourly fees to address recurring issues with no incentive to build long-term systems resilience.
        </p>
        <p>
          We set out to build a different kind of IT company—one built on transparency, predictable flat-rate pricing, and strict SLA accountability. We wanted to offer growing businesses the benefits of having their own dedicated Chief Information Officer and advanced DevOps engineering team at a fraction of the cost of internal hires.
        </p>
        <p>
          Today, Raynatic Solutions manages critical cloud infrastructure and support operations for mid-market firms across Australia, Europe, and Southeast Asia. While we have grown, our focus remains on providing proactive, secure systems that allow our clients to focus on growing their businesses.
        </p>
      </div>

    </div>
  </section>

  <!-- Section 2: Values -->
  <section class="py-24 border-b border-border bg-bg-2">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      
      <!-- Values Header -->
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-4 reveal">
        <span class="text-xs uppercase tracking-widest text-accent font-mono font-bold">Core Foundations</span>
        <h2 class="text-3xl font-bold text-white">Our Values</h2>
        <p class="text-text-muted">The operational principles that guide our support and architectural designs daily.</p>
      </div>

      <!-- Values Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {values.map(val => (
          <div class="glass-panel border border-border p-8 rounded-2xl flex items-start gap-6 reveal">
            <div class="p-3 bg-accent/10 text-accent rounded-xl w-fit flex-shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={val.icon} />
              </svg>
            </div>
            <div class="space-y-2">
              <h3 class="text-base font-bold text-white">{val.name}</h3>
              <p class="text-xs text-text-muted leading-relaxed">{val.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Section 3: Team Grid -->
  <section class="py-24 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      
      <!-- Team Header -->
      <div class="max-w-3xl mb-16 space-y-4 reveal">
        <span class="text-xs uppercase tracking-widest text-accent font-mono font-bold">People</span>
        <h2 class="text-3xl font-bold text-white">Our Leadership Team</h2>
        <p class="text-text-muted">A dedicated group of senior cloud architects, security operations leads, and client advocates based in Melbourne.</p>
      </div>

      <!-- Team Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {team.map(member => (
          <div class="glass-panel border border-border rounded-2xl p-6 text-center hover-glow reveal">
            <!-- Circular Placeholder Photo -->
            <div class="w-24 h-24 bg-accent-2/10 border border-accent rounded-full mx-auto flex items-center justify-center text-accent text-2xl font-bold font-mono mb-6">
              {member.initials}
            </div>
            <h3 class="text-base font-bold text-white">{member.name}</h3>
            <p class="text-xs text-text-muted font-mono mt-1 mb-6">{member.title}</p>
            
            <!-- LinkedIn link -->
            <a 
              href="https://linkedin.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1 text-xs font-mono text-accent hover:underline"
              aria-label={`${member.name} LinkedIn Profile`}
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              Connect
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Section 4: Timeline -->
  <section class="py-24 border-b border-border bg-bg-2">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      
      <!-- Timeline Header -->
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-4 reveal">
        <span class="text-xs uppercase tracking-widest text-accent font-mono font-bold">Milestones</span>
        <h2 class="text-3xl font-bold text-white">Our Timeline</h2>
      </div>

      <!-- Timeline Vertical Layout -->
      <div class="relative max-w-3xl mx-auto space-y-8 before:absolute before:inset-y-0 before:left-8 md:before:left-1/2 before:w-[1px] before:bg-border">
        {timeline.map((item, idx) => (
          <div class={`flex flex-col md:flex-row items-start gap-8 relative ${idx % 2 === 0 ? '' : 'md:flex-row-reverse'}`}>
            
            <!-- Bullet Point Indicator -->
            <div class="absolute left-8 md:left-1/2 w-4 h-4 bg-accent border-4 border-bg rounded-full -translate-x-1.5 z-10"></div>
            
            <!-- Timeline Card Box -->
            <div class="w-full md:w-1/2 pl-16 md:pl-0 md:px-8">
              <div class="glass-panel border border-border p-6 rounded-2xl reveal">
                <span class="text-lg font-bold font-mono text-accent-2 block mb-2">{item.year}</span>
                <h3 class="text-base font-bold text-white mb-2">{item.title}</h3>
                <p class="text-xs text-text-muted leading-relaxed">{item.desc}</p>
              </div>
            </div>
            <div class="hidden md:block w-1/2"></div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Section 5: Certifications Grid -->
  <section class="py-24 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      
      <!-- Certifications Header -->
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-4 reveal">
        <span class="text-xs uppercase tracking-widest text-accent font-mono font-bold">Credentials</span>
        <h2 class="text-3xl font-bold text-white">Certifications & Compliance</h2>
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {awards.map(item => (
          <div class="glass-panel border border-border p-6 rounded-2xl text-center reveal">
            <h3 class="text-base font-bold text-white mb-2">{item.name}</h3>
            <p class="text-xs text-text-muted font-mono">{item.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Section 6: CTA Banner -->
  <section data-theme="dark" class="py-24 relative overflow-hidden bg-bg">
    <div class="absolute inset-0 cta-gradient-pulse opacity-40 z-0"></div>
    <div class="max-w-5xl mx-auto px-4 md:px-8 text-center relative z-10 space-y-8 reveal">
      <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight">
        Experience the Raynatic Difference
      </h2>
      <p class="text-base text-text-muted max-w-xl mx-auto">
        Contact our Melbourne headquarters today to discuss your IT outsourcing needs and request a free network audit.
      </p>
      <div class="flex justify-center">
        <a href="/contact" class="px-8 py-4 bg-accent hover:bg-accent/80 text-bg font-sans font-bold rounded-xl transition-all shadow-glow hover:shadow-hover">
          Let's Work Together &rarr;
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
