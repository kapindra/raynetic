---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Terms of Service — Raynetic Solutions"
  description="Terms of Service for Raynetic Solutions. Includes information on acceptable use, intellectual property, limitation of liability, and Australian Consumer Law."
>
  
  <section class="relative pt-32 pb-16 border-b border-border">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="max-w-4xl mx-auto px-4 text-center space-y-4 relative z-10">
      <nav class="flex items-center justify-center gap-2 text-xs font-mono text-text-muted">
        <a href="/" class="hover:text-accent">Home</a>
        <span>/</span>
        <span class="text-white">Terms of Service</span>
      </nav>
      <h1 class="text-3xl md:text-5xl font-bold text-white font-display">
        Terms of Service
