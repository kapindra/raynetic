---
import BaseLayout from '../layouts/BaseLayout.astro';

const caseStudies = [
  {
    title: "Zero-Downtime AWS Migration",
    client: "Karta Tech Labs",
    industry: "SaaS Provider",
    stat: "99.99% Uptime",
    statLabel: "Post-Migration Stability",
    summary: "Migrated a legacy database clusters and React client panels to AWS multi-region infrastructure using Infrastructure as Code (Terraform), reducing billing costs by 35%.",
    tags: ["AWS", "Terraform", "Docker", "DevOps"],
    metrics: ["$12k monthly savings", "CI/CD deploys under 5 mins"]
  },
  {
    title: "Essential Eight Security Hardening",
    client: "Melbourne Care Clinics",
    industry: "Healthcare Provider",
    stat: "Level 3",
    statLabel: "ACSC Compliance Rating",
    summary: "Audited network directories, configured Okta Single Sign-On (SSO), and implemented advanced patch managers to meet strict health privacy regulations.",
    tags: ["Cybersecurity", "Essential Eight", "Okta", "Compliance"],
    metrics: ["ISO 27001 Ready", "150+ staff endpoints secured"]
  },
  {
    title: "Flat-rate Helpdesk Integration",
    client: "Vanguard Legal Group",
    industry: "Corporate Law",
    stat: "<12 Min",
    statLabel: "Average Helpdesk Response",
    summary: "Transitioned 80 staff members from reactive break-fix IT consultants to our flat-rate managed IT services, eliminating daily networking dropouts.",
    tags: ["Managed IT", "SLA Support", "Proactive NOC"],
    metrics: ["98% CSAT Rating", "Zero lost files over 12 months"]
  }
];
---

<BaseLayout 
  title="Case Studies & Portfolio — Raynatic Solutions"
  description="Review our case studies highlighting successful cloud migrations, Essential Eight cybersecurity compliance setups, and managed helpdesk support outcomes."
>
  
  <!-- Case Studies Hero -->
  <section class="relative pt-32 pb-20 border-b border-border">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10 text-center space-y-6">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center justify-center gap-2 text-xs font-mono text-text-muted">
        <a href="/" class="hover:text-accent">Home</a>
        <span>/</span>
        <span class="text-white">Case Studies</span>
      </nav>
      
      <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight animate-fade-up">
        Our Success Stories
      </h1>
      <p class="text-base sm:text-lg text-text-muted max-w-2xl mx-auto animate-fade-up delay-100">
        How we help mid-market Australian enterprises optimize their cloud operations, secure networks, and eliminate IT downtime.
      </p>
    </div>
  </section>

  <!-- Section 1: Case Studies Grid -->
  <section class="py-24 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      
      <div class="space-y-16">
        {caseStudies.map((study, idx) => (
          <div class={`glass-panel border border-border p-8 md:p-12 rounded-2xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center reveal ${idx % 2 === 0 ? '' : 'lg:flex-row-reverse'}`}>
            
            <!-- Left/Stats Column -->
            <div class="lg:col-span-4 bg-white/5 border border-border p-8 rounded-2xl text-center space-y-3 relative overflow-hidden">
              <div class="absolute inset-0 bg-radial-gradient from-accent/10 to-transparent pointer-events-none"></div>
              <span class="text-4xl md:text-5xl font-bold text-accent font-mono block">
                {study.stat}
              </span>
              <span class="text-xs uppercase tracking-widest text-text-muted font-mono block">
                {study.statLabel}
              </span>
            </div>

            <!-- Right/Content Column -->
            <div class="lg:col-span-8 space-y-6">
              <div class="space-y-2">
                <span class="text-xs text-accent font-mono">{study.client} &bull; {study.industry}</span>
                <h2 class="text-2xl font-bold text-white">{study.title}</h2>
              </div>
              <p class="text-sm text-text-muted leading-relaxed">
                {study.summary}
              </p>
              
              <!-- Metrics list -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pb-4">
                {study.metrics.map(metric => (
                  <div class="flex items-center gap-2 text-xs text-text">
                    <span class="text-success font-bold">✓</span>
                    <span>{metric}</span>
                  </div>
                ))}
              </div>
              
              <!-- Tech tags -->
              <div class="flex flex-wrap gap-2 pt-4 border-t border-border">
                {study.tags.map(tag => (
                  <span class="px-3 py-1 bg-bg-2 border border-border rounded-full text-xs text-text-muted font-mono">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Section 2: CTA Banner -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 cta-gradient-pulse opacity-40 z-0"></div>
    <div class="max-w-5xl mx-auto px-4 md:px-8 text-center relative z-10 space-y-8 reveal">
      <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight">
        Let's Write Your Uptime Success Story
      </h2>
      <p class="text-base text-text-muted max-w-xl mx-auto">
        Partner with Raynatic Solutions. Speak with our Melbourne engineers today to discuss custom setups and flat-rate monthly support.
      </p>
      <div class="flex justify-center">
        <a href="/contact" class="px-8 py-4 bg-accent hover:bg-accent/80 text-bg font-sans font-bold rounded-xl transition-all shadow-glow hover:shadow-hover">
          Request a Custom SLA Quote &rarr;
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
