---
import BaseLayout from '../layouts/BaseLayout.astro';

const caseStudies = [
  {
    title: "E-Commerce Headless WordPress Launch",
    client: "Karta Tech Labs",
    industry: "Online Retailer",
    stat: "+140%",
    statLabel: "Post-Launch Conversion Growth",
    summary: "Designed and engineered a custom headless WordPress frontend integrated with Shopify APIs, reducing page load times to 1.1 seconds and optimizing Core Web Vitals.",
    tags: ["Headless CMS", "React/Next.js", "UI/UX Design", "Web Development"],
    metrics: ["35% server cost reduction", "1.1s Largest Contentful Paint"]
  },
  {
    title: "Brand Identity & Lead Gen Campaign",
    client: "Vanguard Legal Group",
    industry: "Corporate Law",
    stat: "4.2x ROI",
    statLabel: "Paid Campaign Lead Yield",
    summary: "Crafted a premium visual identity style guide, corporate marketing collateral, and executed targeted Google and social advertising campaigns that multiplied monthly client inquiries.",
    tags: ["Branding", "Graphics Design", "Google Ads", "Social Campaigns"],
    metrics: ["420% increase in inquiries", "50% lower client acquisition cost"]
  },
  {
    title: "Human-Centric Patient Booking App",
    client: "Melbourne Care Clinics",
    industry: "Healthcare Services",
    stat: "12 Wks",
    statLabel: "App Store Launch Timeline",
    summary: "Designed and engineered a secure cross-platform booking application using human-centric navigation flows, streamlining patient onboarding cycles.",
    tags: ["iOS & Android App", "UI/UX Design", "Agile Sprints", "Product Lifecycle"],
    metrics: ["98% user satisfaction rating", "85% reduction in booking admin tasks"]
  }
];
---

<BaseLayout 
  title="Case Studies & Portfolio — Raynetic Solutions"
  description="Review our case studies highlighting successful web design and development projects, custom mobile applications, and high-performance digital marketing campaigns."
>
  
  <!-- Case Studies Hero -->
  <section class="relative pt-32 pb-20 border-b border-border">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10 text-center space-y-6">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center justify-center gap-2 text-xs font-mono text-text-muted">
        <a href="/" class="hover:text-accent">Home</a>
        <span>/</span>
        <span class="text-white">Case Studies</span>
      </nav>
      
      <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight animate-fade-up">
        Our Success Stories
      </h1>
      <p class="text-base sm:text-lg text-text-muted max-w-2xl mx-auto animate-fade-up delay-100">
        How we help ambitious businesses build memorable brand identities, custom-coded platforms, and high-converting marketing campaigns.
      </p>
    </div>
  </section>

  <!-- Section 1: Case Studies Grid -->
  <section class="py-24 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      
      <div class="space-y-16">
        {caseStudies.map((study, idx) => (
          <div class={`glass-panel border border-border p-8 md:p-12 rounded-2xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center reveal ${idx % 2 === 0 ? '' : 'lg:flex-row-reverse'}`}>
            
            <!-- Left/Stats Column -->
            <div class="lg:col-span-4 bg-white/5 border border-border p-8 rounded-2xl text-center space-y-3 relative overflow-hidden">
              <div class="absolute inset-0 bg-radial-gradient from-accent/10 to-transparent pointer-events-none"></div>
              <span class="text-4xl md:text-5xl font-bold text-accent font-mono block">
                {study.stat}
              </span>
              <span class="text-xs uppercase tracking-widest text-text-muted font-mono block">
                {study.statLabel}
              </span>
            </div>

            <!-- Right/Content Column -->
            <div class="lg:col-span-8 space-y-6">
              <div class="space-y-2">
                <span class="text-xs text-accent font-mono">{study.client} &bull; {study.industry}</span>
                <h2 class="text-2xl font-bold text-white">{study.title}</h2>
              </div>
              <p class="text-sm text-text-muted leading-relaxed">
                {study.summary}
              </p>
              
              <!-- Metrics list -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pb-4">
                {study.metrics.map(metric => (
                  <div class="flex items-center gap-2 text-xs text-text">
                    <span class="text-success font-bold">✓</span>
                    <span>{metric}</span>
                  </div>
                ))}
              </div>
              
              <!-- Tech tags -->
              <div class="flex flex-wrap gap-2 pt-4 border-t border-border">
                {study.tags.map(tag => (
                  <span class="px-3 py-1 bg-bg-2 border border-border rounded-full text-xs text-text-muted font-mono">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Section 2: CTA Banner -->
  <section data-theme="dark" class="py-24 relative overflow-hidden bg-bg">
    <div class="absolute inset-0 cta-gradient-pulse opacity-40 z-0"></div>
    <div class="max-w-5xl mx-auto px-4 md:px-8 text-center relative z-10 space-y-8 reveal">
      <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight">
        Let's Design Your Next Success Story
      </h2>
      <p class="text-base text-text-muted max-w-xl mx-auto">
        Partner with Raynetic Solutions. Speak with our Melbourne creative and development teams today to discuss custom applications, branding, and conversion strategies.
      </p>
      <div class="flex justify-center">
        <a href="/contact" class="px-8 py-4 bg-accent hover:bg-accent/80 text-bg font-sans font-bold rounded-xl transition-all shadow-glow hover:shadow-hover">
          Get a Free Consultation &rarr;
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
