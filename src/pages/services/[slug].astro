---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(service => ({
    params: { slug: service.id },
    props: { service }
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const serviceDetails = {
  name: service.data.title,
  description: service.data.excerpt,
  providerName: "Raynatic Solutions"
};
---

<BaseLayout 
  title={`${service.data.title} Services — Raynatic Solutions`}
  description={service.data.excerpt}
  serviceDetails={serviceDetails}
>
  
  <!-- Service Detail Hero -->
  <section class="relative pt-32 pb-20 border-b border-border">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10 text-center space-y-6">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center justify-center gap-2 text-xs font-mono text-text-muted">
        <a href="/" class="hover:text-accent">Home</a>
        <span>/</span>
        <a href="/services" class="hover:text-accent">Services</a>
        <span>/</span>
        <span class="text-white">{service.data.title}</span>
      </nav>
      
      <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight animate-fade-up">
        {service.data.title}
      </h1>
      <p class="text-base sm:text-lg text-text-muted max-w-2xl mx-auto animate-fade-up delay-100">
        {service.data.headline}
      </p>
    </div>
  </section>

  <!-- Service Detail Body -->
  <section class="py-24 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-16">
      
      <!-- Main Content (Left) -->
      <div class="lg:col-span-8 space-y-12">
        
        <!-- Markdown Body Content -->
        <div class="prose prose-invert max-w-none prose-headings:font-display prose-headings:font-bold prose-p:text-text-muted prose-p:leading-relaxed prose-h3:text-white prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4">
          <Content />
        </div>

        <!-- Features Checklist -->
        <div class="space-y-6">
          <h3 class="text-xl font-bold text-white font-display">What's Included in This Service</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {service.data.features.map(feat => (
              <div class="flex items-start gap-3 p-4 bg-surface/50 border border-border rounded-xl">
                <span class="p-1 bg-accent/20 text-accent rounded-full text-xs flex-shrink-0 mt-0.5">✓</span>
                <span class="text-xs text-text-muted leading-relaxed">{feat}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- How It Works (Process) -->
        <div class="space-y-6">
          <h3 class="text-xl font-bold text-white font-display">Our Process Flow</h3>
          <div class="relative pl-8 border-l border-border space-y-8">
            {service.data.process.map((step, idx) => {
              const [title, desc] = step.split(':');
              return (
                <div class="relative">
                  <div class="absolute -left-[41px] w-6 h-6 bg-accent-2 border-4 border-bg rounded-full flex items-center justify-center text-[10px] font-bold text-white font-mono">
                    {idx + 1}
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-white mb-1">{title}</h4>
                    <p class="text-xs text-text-muted leading-relaxed">{desc}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- FAQ Accordion -->
        <div class="space-y-6 pt-6">
          <h3 class="text-xl font-bold text-white font-display">Frequently Asked Questions</h3>
          <div class="space-y-4">
            {service.data.faqs.map((faq, idx) => (
              <details class="group glass-panel border border-border rounded-2xl p-6 [&_summary::-webkit-details-marker]:hidden cursor-pointer" open={idx === 0}>
                <summary class="flex items-center justify-between text-sm font-bold text-white focus:outline-none select-none">
                  <span>{faq.question}</span>
                  <svg class="w-5 h-5 text-accent transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <p class="text-xs text-text-muted leading-relaxed mt-4 pt-4 border-t border-border">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </div>

      </div>

      <!-- Sidebar (Right) -->
      <aside class="lg:col-span-4 space-y-8">
        <!-- Who It's For Card -->
        <div class="glass-panel border border-border p-8 rounded-2xl space-y-6 shadow-card">
          <h3 class="text-base font-bold text-white font-display">Ideal Profile</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            {service.data.whoItFor}
          </p>
        </div>

        <!-- Quick Call to Action Card -->
        <div class="glass-panel border border-accent/20 bg-accent/5 p-8 rounded-2xl space-y-6 shadow-glow relative overflow-hidden">
          <div class="absolute inset-0 bg-radial-gradient from-accent/10 to-transparent pointer-events-none"></div>
          <h3 class="text-base font-bold text-white font-display relative z-10">Get a Free Assessment</h3>
          <p class="text-xs text-text-muted leading-relaxed relative z-10">
            Request a free 30-minute infrastructure consult. We will audit your current workflows and provide recommendations.
          </p>
          <a href="/contact" class="w-full text-center block py-3 bg-accent text-bg font-sans font-bold text-xs rounded-xl transition-all shadow-glow hover:shadow-hover relative z-10">
            Book a consultation
          </a>
        </div>
      </aside>

    </div>
  </section>

  <!-- CTA Banner Section -->
  <section data-theme="dark" class="py-24 relative overflow-hidden bg-bg">
    <div class="absolute inset-0 cta-gradient-pulse opacity-40 z-0"></div>
    <div class="max-w-5xl mx-auto px-4 md:px-8 text-center relative z-10 space-y-8 reveal">
      <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight">
        Optimize Your {service.data.title} Operations
      </h2>
      <p class="text-base text-text-muted max-w-xl mx-auto">
        Speak directly with one of our certified engineers in Melbourne. Let's design a secure, automated framework to scale your business.
      </p>
      <div class="flex justify-center gap-4">
        <a href="/contact" class="px-8 py-4 bg-accent hover:bg-accent/80 text-bg font-sans font-bold rounded-xl transition-all shadow-glow hover:shadow-hover">
          Request a Custom SLA Quote &rarr;
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
