---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<BaseLayout 
  title="Our IT Services — Raynatic Solutions"
  description="Explore our range of premium IT services, including custom software development, cloud DevOps automation, 24/7 SLA helpdesk support, and cybersecurity."
>
  
  <!-- Services Hero -->
  <section class="relative pt-32 pb-20 border-b border-border">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10 text-center space-y-6">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center justify-center gap-2 text-xs font-mono text-text-muted">
        <a href="/" class="hover:text-accent">Home</a>
        <span>/</span>
        <span class="text-white">Services</span>
      </nav>
      
      <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight animate-fade-up">
        Our IT Services
      </h1>
      <p class="text-base sm:text-lg text-text-muted max-w-2xl mx-auto animate-fade-up delay-100">
        Enterprise-grade solutions designed to secure, automate, and scale your business operations.
      </p>
    </div>
  </section>

  <!-- Section 1: Services Directory Grid -->
  <section class="py-24 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedServices.map(service => (
          <div class="gradient-border-card p-8 md:p-10 border border-border rounded-2xl flex flex-col justify-between hover-glow reveal">
            <div class="space-y-6">
              <!-- Service Icon -->
              <div class="p-3 bg-accent/10 text-accent rounded-xl w-fit">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={service.data.icon} />
                </svg>
              </div>
              
              <!-- Service Header -->
              <h2 class="text-2xl font-bold text-white">{service.data.title}</h2>
              <p class="text-xs text-accent font-mono uppercase tracking-wider">{service.data.headline}</p>
              
              <!-- Service Excerpt -->
              <p class="text-sm text-text-muted leading-relaxed">
                {service.data.excerpt}
              </p>
              
              <!-- Service Core Focus Points -->
              <ul class="space-y-2 pt-2">
                {service.data.features.slice(0, 3).map(feat => (
                  <li class="flex items-start gap-3 text-xs text-text-muted">
                    <span class="text-accent mt-0.5">•</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
            
            <!-- Actions -->
            <div class="pt-8 border-t border-border mt-8 flex items-center justify-between">
              <span class="text-xs text-text-faint font-mono uppercase">Melbourne Support 24/7</span>
              <a href={`/services/${service.id}`} class="px-5 py-2.5 bg-accent hover:bg-accent/80 text-bg font-sans font-bold text-xs rounded-xl transition-all shadow-glow hover:shadow-hover">
                Explore Service &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Section 2: Core Promise (vCIO) -->
  <section class="py-24 border-b border-border bg-bg-2">
    <div class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      
      <div class="lg:col-span-6 space-y-6 reveal">
        <span class="text-xs uppercase tracking-widest text-accent font-mono font-bold">Virtual CIO Strategy</span>
        <h2 class="text-3xl md:text-5xl font-bold text-white">We Align Technology with Your Growth</h2>
        <p class="text-text-muted leading-relaxed">
          Daily helpdesk support keeps your staff working, but strategic IT alignment is what expands your business capabilities. Every Raynatic Solutions contract includes quarterly strategic reviews with a dedicated Virtual CIO.
        </p>
        <p class="text-text-muted leading-relaxed">
          We review your infrastructure lifecycle, identify software bottlenecks, audit cybersecurity risks, and plan capacity expansions. This ensures you spend your budget on the exact tools that drive growth, not just on keeping old hardware alive.
        </p>
      </div>

      <div class="lg:col-span-6 reveal">
        <div class="glass-panel border border-border p-8 rounded-2xl space-y-6 shadow-card">
          <h3 class="text-lg font-bold text-white">Included in Every SLA Plan:</h3>
          <ul class="space-y-3">
            <li class="flex items-center gap-3 text-sm text-text-muted">
              <span class="text-accent">✓</span> 24/7/365 Network Operations Center (NOC) monitoring
            </li>
            <li class="flex items-center gap-3 text-sm text-text-muted">
              <span class="text-accent">✓</span> Unlimited L1-L3 remote support ticketing
            </li>
            <li class="flex items-center gap-3 text-sm text-text-muted">
              <span class="text-accent">✓</span> Critical incident response SLA within 15 minutes
            </li>
            <li class="flex items-center gap-3 text-sm text-text-muted">
              <span class="text-accent">✓</span> Automated cloud backup audits and verification scans
            </li>
            <li class="flex items-center gap-3 text-sm text-text-muted">
              <span class="text-accent">✓</span> Quarterly vCIO strategic infrastructure reviews
            </li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <!-- Section 3: CTA Banner -->
  <section data-theme="dark" class="py-24 relative overflow-hidden bg-bg">
    <div class="absolute inset-0 cta-gradient-pulse opacity-40 z-0"></div>
    <div class="max-w-5xl mx-auto px-4 md:px-8 text-center relative z-10 space-y-8 reveal">
      <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight">
        Ready for a Custom Technical Audit?
      </h2>
      <p class="text-base text-text-muted max-w-xl mx-auto">
        Speak with one of our senior Melbourne system architects to receive a free, no-obligation audit of your cybersecurity defenses and cloud costs.
      </p>
      <div class="flex justify-center">
        <a href="/contact" class="px-8 py-4 bg-accent hover:bg-accent/80 text-bg font-sans font-bold rounded-xl transition-all shadow-glow hover:shadow-hover">
          Request a Custom Assessment &rarr;
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
