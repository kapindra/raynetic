---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import techStack from '../../data/techStack.json';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<BaseLayout 
  title="Our Services — Raynetic Solutions"
  description="Explore our range of premium digital services, including web design and development, custom mobile applications, UI/UX design, graphics design, and digital marketing."
>
  
  <!-- Services Hero -->
  <section class="relative pt-32 pb-20 border-b border-border">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10 text-center space-y-6">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center justify-center gap-2 text-xs font-mono text-text-muted">
        <a href="/" class="hover:text-accent">Home</a>
        <span>/</span>
        <span class="text-white">Services</span>
      </nav>
      
      <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight animate-fade-up">
        Our Solutions
      </h1>
      <p class="text-base sm:text-lg text-text-muted max-w-2xl mx-auto animate-fade-up delay-100">
        Enterprise-grade digital design, development, and marketing solutions built to scale your business online.
      </p>
    </div>
  </section>

  <!-- Section 1: Services Directory Grid -->
  <section class="py-24 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedServices.map(service => (
          <div class="gradient-border-card p-8 md:p-10 border border-border rounded-2xl flex flex-col justify-between hover-glow reveal">
            <div class="space-y-6">
              <!-- Service Icon -->
              <div class="p-3 bg-accent/10 text-accent rounded-xl w-fit">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={service.data.icon} />
                </svg>
              </div>
              
              <!-- Service Header -->
              <h2 class="text-2xl font-bold text-white">{service.data.title}</h2>
              <p class="text-xs text-accent font-mono uppercase tracking-wider">{service.data.headline}</p>
              
              <!-- Service Excerpt -->
              <p class="text-base text-text-muted leading-relaxed">
                {service.data.excerpt}
              </p>
              
              <!-- Service Core Focus Points -->
              <ul class="space-y-2 pt-2">
                {service.data.features.slice(0, 3).map(feat => (
                  <li class="flex items-start gap-3 text-base text-text-muted">
                    <span class="text-accent mt-0.5">•</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
            
            <!-- Actions -->
            <div class="pt-8 border-t border-border mt-8 flex items-center justify-between">
              <span class="text-xs text-text-faint font-mono uppercase">Premium Agency Standard</span>
              <a href={`/services/${service.id}`} class="px-5 py-2.5 bg-accent hover:bg-accent/80 text-bg font-sans font-bold text-xs rounded-xl transition-all shadow-glow hover:shadow-hover">
                Explore Service &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Section: Tech Stack & Toolkit -->
  <section class="py-24 border-b border-border bg-bg-2 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none opacity-40"></div>
    <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10">
      
      <!-- Tech Stack Header -->
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4 reveal">
        <span class="text-xs uppercase tracking-widest text-accent font-mono font-bold font-semibold">Our Toolkit</span>
        <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight">Powering Brands with Best-in-Class Technology</h2>
        <p class="text-base text-text-muted max-w-2xl mx-auto">
          We leverage industry-leading frameworks, design suites, and growth-marketing tools across all our custom projects.
        </p>
      </div>

      <!-- Filter Tabs -->
      <div class="flex flex-wrap justify-center gap-3 mb-12 reveal">
        <button class="filter-btn active px-5 py-2.5 border border-accent text-accent bg-accent/10 rounded-xl text-sm font-mono font-medium transition-all duration-300 cursor-pointer" data-filter="all">All Toolkit</button>
        <button class="filter-btn px-5 py-2.5 border border-border text-text-muted hover:border-accent hover:text-accent rounded-xl text-sm font-mono font-medium transition-all duration-300 cursor-pointer" data-filter="web">Web Systems</button>
        <button class="filter-btn px-5 py-2.5 border border-border text-text-muted hover:border-accent hover:text-accent rounded-xl text-sm font-mono font-medium transition-all duration-300 cursor-pointer" data-filter="mobile">Mobile Apps</button>
        <button class="filter-btn px-5 py-2.5 border border-border text-text-muted hover:border-accent hover:text-accent rounded-xl text-sm font-mono font-medium transition-all duration-300 cursor-pointer" data-filter="design">UI/UX & Creative</button>
        <button class="filter-btn px-5 py-2.5 border border-border text-text-muted hover:border-accent hover:text-accent rounded-xl text-sm font-mono font-medium transition-all duration-300 cursor-pointer" data-filter="marketing">Marketing & SEO</button>
      </div>

      <!-- Tech Stack Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-6 min-h-[380px]">
        {techStack.map(tech => (
          <div 
            class={`tech-card glass-panel border border-border p-6 rounded-2xl flex flex-col items-center justify-between text-center hover-glow reveal group ${tech.category}`}
            style={`--brand-color: ${tech.color};`}
          >
            <div class="tech-icon-wrapper p-4 bg-surface/50 border border-border rounded-xl text-text-muted transition-all duration-300 w-16 h-16 flex items-center justify-center shadow-sm">
              <svg class="w-10 h-10 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={tech.path} />
              </svg>
            </div>
            <div class="mt-4 space-y-1">
              <h4 class="tech-title text-sm font-bold text-white transition-colors duration-300">{tech.name}</h4>
              <p class="text-[11px] font-mono text-text-muted">{tech.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <style>
    .tech-card {
      transition: opacity 0.3s ease, transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
      display: flex;
    }
    .tech-card:hover {
      border-color: var(--brand-color) !important;
      box-shadow: 0 10px 30px -10px color-mix(in srgb, var(--brand-color) 20%, transparent) !important;
      transform: translateY(-4px);
    }
    .tech-card:hover .tech-icon-wrapper {
      color: var(--brand-color) !important;
      border-color: var(--brand-color) !important;
      background-color: color-mix(in srgb, var(--brand-color) 10%, transparent) !important;
    }
    .tech-card:hover .tech-title {
      color: var(--brand-color) !important;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.tech-card');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          // Set active button state styling
          buttons.forEach(b => {
            b.classList.remove('active', 'border-accent', 'text-accent', 'bg-accent/10');
            b.classList.add('border-border', 'text-text-muted');
          });
          btn.classList.add('active', 'border-accent', 'text-accent', 'bg-accent/10');
          btn.classList.remove('border-border', 'text-text-muted');

          const filter = btn.getAttribute('data-filter');

          cards.forEach(card => {
            if (filter === 'all' || card.classList.contains(filter)) {
              card.style.display = 'flex';
              setTimeout(() => {
                card.style.opacity = '1';
                card.style.transform = 'scale(1)';
              }, 10);
            } else {
              card.style.opacity = '0';
              card.style.transform = 'scale(0.95)';
              setTimeout(() => {
                card.style.display = 'none';
              }, 300);
            }
          });
        });
      });
    });
  </script>

  <!-- Section 2: Core Promise -->
  <section class="py-24 border-b border-border bg-bg-2">
    <div class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      
      <div class="lg:col-span-6 space-y-6 reveal">
        <span class="text-xs uppercase tracking-widest text-accent font-mono font-bold">Strategic Brand Growth</span>
        <h2 class="text-3xl md:text-5xl font-bold text-white">We Align Creative Design with Performance-Driven Technology</h2>
        <p class="text-text-muted leading-relaxed">
          Bespoke digital design and high-performance development are critical, but strategic alignment is what accelerates brand growth. Every Raynetic Solutions project is engineered to capture high-intent audiences and convert them into loyal clients.
        </p>
        <p class="text-text-muted leading-relaxed">
          We review your online presence, identify conversion bottlenecks, audit search engine visibility, and plan capacity expansions. This ensures you spend your budget on the exact marketing and development tools that drive real revenue growth, not just vanity metrics.
        </p>
      </div>

      <div class="lg:col-span-6 reveal">
        <div class="glass-panel border border-border p-8 rounded-2xl space-y-6 shadow-card">
          <h3 class="text-lg font-bold text-white">Our Agency Process & Commitments:</h3>
          <ul class="space-y-3">
            <li class="flex items-center gap-3 text-sm text-text-muted">
              <span class="text-accent">✓</span> Custom visual identity systems and UI/UX design guidelines
            </li>
            <li class="flex items-center gap-3 text-sm text-text-muted">
              <span class="text-accent">✓</span> Search engine optimized, custom-coded websites with fast load speeds
            </li>
            <li class="flex items-center gap-3 text-sm text-text-muted">
              <span class="text-accent">✓</span> Targeted paid campaigns and lead generation workflows
            </li>
            <li class="flex items-center gap-3 text-sm text-text-muted">
              <span class="text-accent">✓</span> High-fidelity, mobile-responsive layout testing across device screens
            </li>
            <li class="flex items-center gap-3 text-sm text-text-muted">
              <span class="text-accent">✓</span> Dedicated project managers and transparent, real-time analytics reports
            </li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <!-- Section 3: CTA Banner -->
  <section data-theme="dark" class="py-24 relative overflow-hidden bg-bg">
    <div class="absolute inset-0 cta-gradient-pulse opacity-40 z-0"></div>
    <div class="max-w-5xl mx-auto px-4 md:px-8 text-center relative z-10 space-y-8 reveal">
      <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight">
        Ready for a Free Website & SEO Audit?
      </h2>
      <p class="text-base text-text-muted max-w-xl mx-auto">
        Speak with one of our senior Brisbane strategy consultants to receive a free, no-obligation audit of your website's performance, search rankings, and UI/UX conversion bottlenecks.
      </p>
      <div class="flex justify-center">
        <a href="/contact" class="px-8 py-4 bg-accent hover:bg-accent/80 text-bg font-sans font-bold rounded-xl transition-all shadow-glow hover:shadow-hover">
          Request a Free Audit &rarr;
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
