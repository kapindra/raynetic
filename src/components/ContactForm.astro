---
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID || "xoqgkkpj"; // Default fallback endpoint
---

<div class="glass-panel p-8 md:p-10 rounded-2xl border border-border shadow-card relative overflow-hidden">
  
  <!-- Success Overlay -->
  <div id="form-success" class="absolute inset-0 bg-bg/95 z-20 flex flex-col items-center justify-center text-center p-6 opacity-0 pointer-events-none transition-all duration-500">
    <div class="w-16 h-16 bg-success/10 border border-success rounded-full flex items-center justify-center text-success mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h3 class="text-2xl font-bold text-white mb-2">Message Sent!</h3>
    <p class="text-sm text-text-muted max-w-sm mb-6">
      Thank you for contacting Raynetic Solutions. One of our dedicated account managers will respond to your inquiry within 1 business day.
    </p>
    <button 
      id="btn-reset-form" 
      class="px-5 py-2.5 border border-border hover:border-accent text-xs font-mono text-accent rounded-xl transition-all"
    >
      Send Another Message
    </button>
  </div>

  <!-- Form -->
  <form id="contact-form" action={`https://formspree.io/f/${formspreeId}`} method="POST" class="space-y-6">
    
    <!-- Spam Honeypot Field (Hidden from users) -->
    <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

    <!-- Form Fields Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Full Name -->
      <div class="space-y-2">
        <label for="fullName" class="text-xs font-mono text-text-muted block">Full Name <span class="text-accent">*</span></label>
        <input 
          type="text" 
          name="name" 
          id="fullName" 
          required 
          placeholder="John Doe" 
          class="w-full px-4 py-3 bg-white/5 border border-border rounded-xl text-sm text-white placeholder-text-faint focus:border-accent focus:outline-none transition-all focus:ring-1 focus:ring-accent"
        />
        <span class="text-xs text-error hidden" id="err-fullName">Please enter your name.</span>
      </div>

      <!-- Business Email -->
      <div class="space-y-2">
        <label for="businessEmail" class="text-xs font-mono text-text-muted block">Business Email <span class="text-accent">*</span></label>
        <input 
          type="email" 
          name="email" 
          id="businessEmail" 
          required 
          placeholder="john@company.com" 
          class="w-full px-4 py-3 bg-white/5 border border-border rounded-xl text-sm text-white placeholder-text-faint focus:border-accent focus:outline-none transition-all focus:ring-1 focus:ring-accent"
        />
        <span class="text-xs text-error hidden" id="err-email">Please enter a valid business email.</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Company Name -->
      <div class="space-y-2">
        <label for="companyName" class="text-xs font-mono text-text-muted block">Company Name <span class="text-accent">*</span></label>
        <input 
          type="text" 
          name="company" 
          id="companyName" 
          required 
          placeholder="Acme Corp" 
          class="w-full px-4 py-3 bg-white/5 border border-border rounded-xl text-sm text-white placeholder-text-faint focus:border-accent focus:outline-none transition-all focus:ring-1 focus:ring-accent"
        />
        <span class="text-xs text-error hidden" id="err-company">Please enter your company name.</span>
      </div>

      <!-- Phone Number -->
      <div class="space-y-2">
        <label for="phoneNumber" class="text-xs font-mono text-text-muted block">Phone Number <span class="text-text-faint">(Optional)</span></label>
        <input 
          type="tel" 
          name="phone" 
          id="phoneNumber" 
          placeholder="+61 400 000 000" 
          class="w-full px-4 py-3 bg-white/5 border border-border rounded-xl text-sm text-white placeholder-text-faint focus:border-accent focus:outline-none transition-all focus:ring-1 focus:ring-accent"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Service Interest -->
      <div class="space-y-2">
        <label for="serviceInterest" class="text-xs font-mono text-text-muted block">Service Interested In <span class="text-accent">*</span></label>
        <select 
          name="service" 
          id="serviceInterest" 
          required
          class="w-full px-4 py-3 bg-bg border border-border rounded-xl text-sm text-white focus:border-accent focus:outline-none transition-all cursor-pointer focus:ring-1 focus:ring-accent"
        >
          <option value="" disabled selected>Select a Service</option>
          <option value="Web Design & Development">Web Design & Development</option>
          <option value="Mobile App Development">Mobile App Development</option>
          <option value="UI/UX Design">UI/UX Design</option>
          <option value="Digital Marketing Solutions">Digital Marketing Solutions</option>
          <option value="Search Engine Optimization">Search Engine Optimization</option>
          <option value="Graphics & Motion Design">Graphics & Motion Design</option>
          <option value="General Inquiry">General / Other Inquiry</option>
        </select>
        <span class="text-xs text-error hidden" id="err-service">Please select a service interest.</span>
      </div>

      <!-- Project Budget -->
      <div class="space-y-2">
        <label for="projectBudget" class="text-xs font-mono text-text-muted block">Estimated Project Budget <span class="text-accent">*</span></label>
        <select 
          name="budget" 
          id="projectBudget" 
          required
          class="w-full px-4 py-3 bg-bg border border-border rounded-xl text-sm text-white focus:border-accent focus:outline-none transition-all cursor-pointer focus:ring-1 focus:ring-accent"
        >
          <option value="" disabled selected>Select a Budget Range</option>
          <option value="<$5k">Under $5k</option>
          <option value="$5k - $20k">$5k – $20k</option>
          <option value="$20k - $50k">$20k – $50k</option>
          <option value="$50k+">$50k+</option>
          <option value="Ongoing Retainer">Ongoing Strategy Retainer</option>
        </select>
        <span class="text-xs text-error hidden" id="err-budget">Please select a budget range.</span>
      </div>
    </div>

    <!-- Message -->
    <div class="space-y-2">
      <label for="messageText" class="text-xs font-mono text-text-muted block">Project Details & Requirements <span class="text-accent">*</span></label>
      <textarea 
        name="message" 
        id="messageText" 
        required 
        rows="4" 
        placeholder="Briefly describe your project goals, technical details, or support requirements..." 
        class="w-full px-4 py-3 bg-white/5 border border-border rounded-xl text-sm text-white placeholder-text-faint focus:border-accent focus:outline-none transition-all focus:ring-1 focus:ring-accent resize-none"
      ></textarea>
      <span class="text-xs text-text-muted block text-right font-mono" id="char-counter">0 / 20 min characters</span>
      <span class="text-xs text-error hidden block" id="err-message">Message must be at least 20 characters.</span>
    </div>

    <!-- Consent checkboxes -->
    <div class="space-y-3 pt-2">
      <div class="flex items-start gap-3">
        <input 
          type="checkbox" 
          id="consentPolicy" 
          required 
          class="mt-1 accent-accent w-4 h-4 cursor-pointer" 
          aria-required="true"
        />
        <label for="consentPolicy" class="text-sm text-text-muted cursor-pointer select-none">
          I consent to having Raynetic Solutions store my submitted information and contact me in compliance with the <a href="/privacy-policy" target="_blank" class="text-accent hover:underline">Privacy Policy</a>. <span class="text-accent">*</span>
        </label>
      </div>
      <div class="flex items-start gap-3">
        <input 
          type="checkbox" 
          id="newsletterOptIn" 
          name="newsletter" 
          class="mt-1 accent-accent w-4 h-4 cursor-pointer" 
        />
        <label for="newsletterOptIn" class="text-sm text-text-muted cursor-pointer select-none">
          Keep me updated with privacy-first monthly digital marketing and growth strategy recommendations (Optional).
        </label>
      </div>
    </div>

    <!-- Global Error Notice -->
    <div id="form-error-notice" class="p-4 bg-error/10 border border-error/20 text-error text-sm rounded-xl hidden">
      Something went wrong. Please check the fields above and try again, or email info@rayneticsolutions.com.au.
    </div>

    <!-- Submit Button -->
    <div>
      <button 
        type="submit" 
        id="form-submit-btn" 
        class="w-full py-4 bg-accent hover:bg-accent/90 disabled:bg-surface disabled:text-text-muted text-bg font-sans font-bold text-sm rounded-xl transition-all duration-300 shadow-glow hover:shadow-hover flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>Send Message</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>

  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successOverlay = document.getElementById('form-success');
  const errorNotice = document.getElementById('form-error-notice');
  const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement;
  const resetBtn = document.getElementById('btn-reset-form');
  const messageText = document.getElementById('messageText') as HTMLTextAreaElement;
  const charCounter = document.getElementById('char-counter');

  // Input elements
  const fullName = document.getElementById('fullName') as HTMLInputElement;
  const email = document.getElementById('businessEmail') as HTMLInputElement;
  const company = document.getElementById('companyName') as HTMLInputElement;
  const service = document.getElementById('serviceInterest') as HTMLSelectElement;
  const budget = document.getElementById('projectBudget') as HTMLSelectElement;
  const consent = document.getElementById('consentPolicy') as HTMLInputElement;

  // Character Counter for Message Box
  messageText?.addEventListener('input', () => {
    const len = messageText.value.length;
    if (charCounter) {
      charCounter.textContent = `${len} / 20 min characters`;
      if (len >= 20) {
        charCounter.classList.remove('text-text-muted');
        charCounter.classList.add('text-success');
      } else {
        charCounter.classList.remove('text-success');
        charCounter.classList.add('text-text-muted');
      }
    }
  });

  // Simple client-side validator helper
  function validateForm() {
    let isValid = true;

    // Full name
    if (!fullName.value.trim()) {
      document.getElementById('err-fullName')?.classList.remove('hidden');
      isValid = false;
    } else {
      document.getElementById('err-fullName')?.classList.add('hidden');
    }

    // Email regex
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailPattern.test(email.value.trim())) {
      document.getElementById('err-email')?.classList.remove('hidden');
      isValid = false;
    } else {
      document.getElementById('err-email')?.classList.add('hidden');
    }

    // Company
    if (!company.value.trim()) {
      document.getElementById('err-company')?.classList.remove('hidden');
      isValid = false;
    } else {
      document.getElementById('err-company')?.classList.add('hidden');
    }

    // Service Dropdown
    if (!service.value) {
      document.getElementById('err-service')?.classList.remove('hidden');
      isValid = false;
    } else {
      document.getElementById('err-service')?.classList.add('hidden');
    }

    // Budget Dropdown
    if (!budget.value) {
      document.getElementById('err-budget')?.classList.remove('hidden');
      isValid = false;
    } else {
      document.getElementById('err-budget')?.classList.add('hidden');
    }

    // Message details length
    if (messageText.value.length < 20) {
      document.getElementById('err-message')?.classList.remove('hidden');
      isValid = false;
    } else {
      document.getElementById('err-message')?.classList.add('hidden');
    }

    return isValid;
  }

  // Handle Formspree AJAX Submit
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorNotice?.classList.add('hidden');

    if (!validateForm()) return;

    // Loading State
    submitBtn.disabled = true;
    submitBtn.innerHTML = `
      <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-bg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Submitting inquiry...</span>
    `;

    const data = new FormData(form);
    try {
      const response = await fetch(form.action, {
        method: form.method,
        body: data,
        headers: {
          'Accept': 'application/json'
        }
      });

      if (response.ok) {
        // Success state
        successOverlay?.classList.remove('opacity-0', 'pointer-events-none');
        form.reset();
        if (charCounter) charCounter.textContent = '0 / 20 min characters';
      } else {
        const errData = await response.json();
        throw new Error(errData.error || 'Server error');
      }
    } catch (err) {
      // Error state
      errorNotice?.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = `
        <span>Send Message</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      `;
    }
  });

  // Reset form success overlay
  resetBtn?.addEventListener('click', () => {
    successOverlay?.classList.add('opacity-0', 'pointer-events-none');
  });
</script>
