---
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.endsWith('/') && currentPath.length > 1 ? currentPath.slice(0, -1) : currentPath;

const navItems = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
  { name: 'Blog', path: '/blog' },
  { name: 'Contact', path: '/contact' }
];

const services = [
  { name: 'Web Design & Development', slug: 'web-design-development', icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
  { name: 'Mobile App Development', slug: 'mobile-app-development', icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z' },
  { name: 'UI/UX Design', slug: 'ui-ux-design', icon: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm3 4h10M7 14h10' },
  { name: 'Digital Marketing Solutions', slug: 'digital-marketing', icon: 'M11 3.051c-.85.044-1.6.582-1.92 1.378l-3.21 8.026a2 2 0 00-.07.288L3 17.5a1.5 1.5 0 001.5 1.5h15a1.5 1.5 0 001.5-1.5l-2.8-4.757a2 2 0 00-.07-.288l-3.21-8.026c-.32-.796-1.07-1.334-1.92-1.378zM12 8v4m0 4h.01' },
  { name: 'Search Engine Optimization', slug: 'seo-content-services', icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z' },
  { name: 'Graphics & Motion Design', slug: 'graphics-motion-design', icon: 'M7 4v16M17 4v16M3 8h18M3 16h18' }
];
---

<header id="site-header" class="fixed top-0 left-0 w-full z-40 transition-all duration-300 py-6">
  <div class="max-w-7xl mx-auto px-4 md:px-8 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center h-10 group outline-none focus:ring-2 focus:ring-accent rounded-lg" aria-label="Raynetic Solutions Home">
      <img src="/images/logo.png?v=3" width="140" height="40" alt="Raynetic Solutions Logo" class="h-full w-auto logo-img transition-all duration-300 group-hover:opacity-90" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Main Navigation">
      <ul class="flex items-center gap-8">
        <li>
          <a href="/" class={`text-sm font-mono transition-colors hover:text-accent ${cleanPath === '/' ? 'text-accent' : 'text-text-muted'}`}>
            Home
          </a>
        </li>
        
        <!-- Services Mega Menu Trigger -->
        <li class="relative group">
          <button 
            type="button" 
            class={`flex items-center gap-1 text-sm font-mono transition-colors hover:text-accent outline-none focus:text-accent ${cleanPath.startsWith('/services') ? 'text-accent' : 'text-text-muted'}`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            Services
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <!-- Services Dropdown Mega Menu -->
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:pointer-events-auto transition-all duration-300 w-[450px]">
            <div class="bg-surface border border-border rounded-2xl p-6 shadow-card grid grid-cols-1 gap-4">
              <div class="pb-2 border-b border-border">
                <span class="text-xs uppercase tracking-widest text-text-muted font-mono font-bold">Our Core Expertise</span>
              </div>
              {services.map(service => (
                <a 
                  href={`/services/${service.slug}`} 
                  class="flex items-start gap-4 p-3 hover:bg-white/5 rounded-xl transition-all duration-200 group/item"
                >
                  <div class="p-2 bg-accent/10 text-accent rounded-lg group-hover/item:bg-accent group-hover/item:text-bg transition-colors duration-200">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-white group-hover/item:text-accent transition-colors">{service.name}</h4>
                    <p class="text-sm text-text-muted mt-1">Premium digital {service.name.toLowerCase()} solutions.</p>
                  </div>
                </a>
              ))}
              <div class="pt-2 border-t border-border flex justify-end">
                <a href="/services" class="text-xs font-mono text-accent hover:underline flex items-center gap-1">
                  View All Services →
                </a>
              </div>
            </div>
          </div>
        </li>

        {navItems.slice(1).map(item => (
          <li>
            <a 
              href={item.path} 
              class={`text-sm font-mono transition-colors hover:text-accent ${cleanPath === item.path ? 'text-accent' : 'text-text-muted'}`}
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      <!-- Theme Toggle (visible on both desktop and mobile) -->
      <button
        id="theme-toggle"
        type="button"
        class="p-2.5 text-text-muted hover:text-accent hover:bg-white/5 rounded-full transition-all duration-300 outline-none focus:ring-2 focus:ring-accent cursor-pointer flex items-center justify-center"
        aria-label="Toggle Dark/Light Mode"
      >
        <!-- Sun Icon (visible in light mode / dark attribute) -->
        <svg id="theme-toggle-sun" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
        </svg>
        <!-- Moon Icon -->
        <svg id="theme-toggle-moon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Desktop Header CTA -->
      <div class="hidden lg:block">
        <a href="/contact" class="px-5 py-2.5 bg-accent hover:bg-accent/80 text-bg font-sans font-bold text-sm rounded-full transition-all duration-300 shadow-glow hover:shadow-hover">
          Get a Quote
        </a>
      </div>

      <!-- Mobile Navigation Toggle -->
      <button 
        id="mobile-nav-toggle"
        type="button" 
        class="lg:hidden p-2 text-text hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent rounded-lg"
        aria-label="Toggle Mobile Menu"
        aria-expanded="false"
        aria-controls="mobile-overlay"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Overlay Menu -->
  <div 
    id="mobile-overlay" 
    class="fixed inset-0 top-[80px] bg-bg z-30 opacity-0 pointer-events-none lg:hidden transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation Drawer"
  >
    <div class="h-full px-6 py-12 flex flex-col justify-between">
      <nav class="space-y-8" aria-label="Mobile Navigation Link List">
        <ul class="space-y-6">
          <li>
            <a href="/" class="mobile-link text-2xl font-display font-bold text-white block">Home</a>
          </li>
          <li>
            <div class="mobile-link text-2xl font-display font-bold text-white mb-4 block">Services</div>
            <ul class="pl-4 space-y-4 border-l border-border">
              {services.map(service => (
                <li>
                  <a href={`/services/${service.slug}`} class="text-sm font-mono text-text-muted hover:text-accent block">{service.name}</a>
                </li>
              ))}
              <li>
                <a href="/services" class="text-xs font-mono text-accent hover:underline block">All Services →</a>
              </li>
            </ul>
          </li>
          {navItems.slice(1).map(item => (
            <li>
              <a href={item.path} class="mobile-link text-2xl font-display font-bold text-white block">{item.name}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="space-y-6 pb-20">
        <a href="/contact" class="w-full text-center block py-4 bg-accent text-bg font-sans font-bold rounded-xl transition-all shadow-glow">
          Get a Quote
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('mobile-nav-toggle');
  const overlay = document.getElementById('mobile-overlay');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  // Change header appearance on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('glass-nav', 'py-4');
      header?.classList.remove('py-6');
    } else {
      header?.classList.remove('glass-nav', 'py-4');
      header?.classList.add('py-6');
    }
  });

  // Toggle mobile navigation
  let isOpen = false;
  function toggleMenu() {
    isOpen = !isOpen;
    toggle?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    
    if (isOpen) {
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      hamburger?.classList.add('hidden');
      close?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    } else {
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      hamburger?.classList.remove('hidden');
      close?.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  toggle?.addEventListener('click', toggleMenu);
  
  // Close menu when clicking links
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });
  });

  // Theme Toggle Button Logic
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', newTheme);
    localStorage.setItem('raynetic-theme', newTheme);
  });
</script>
