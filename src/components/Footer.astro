---
const currentYear = new Date().getFullYear();
---

<footer data-theme="dark" class="border-t border-border bg-bg-2 pt-20 pb-10 relative">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8 mb-16">
      
      <!-- Column 1: Brand Details -->
      <div class="lg:col-span-4 space-y-6">
        <a href="/" class="flex items-center h-10 group outline-none" aria-label="Raynetic Solutions Home">
          <img src="/images/logo.png?v=3" width="140" height="40" alt="Raynetic Solutions Logo" class="h-full w-auto logo-img transition-all duration-300" />
        </a>
        <p class="text-sm text-text-muted max-w-sm">
          We design, build, and scale high-performance websites, custom applications, and digital marketing strategies that empower forward-thinking brands globally.
        </p>
        
        <!-- Social Icons -->
        <div class="flex items-center gap-4">
          <a href="https://www.linkedin.com/company/raynetic-solutions/posts/?feedView=all" target="_blank" rel="noopener noreferrer" class="p-2 border border-border rounded-lg text-text-muted hover:text-accent hover:border-accent transition-colors" aria-label="LinkedIn">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=61579926421860" target="_blank" rel="noopener noreferrer" class="p-2 border border-border rounded-lg text-text-muted hover:text-accent hover:border-accent transition-colors" aria-label="Facebook">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.75z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/rayneticsolutions/" target="_blank" rel="noopener noreferrer" class="p-2 border border-border rounded-lg text-text-muted hover:text-accent hover:border-accent transition-colors" aria-label="Instagram">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
        </div>
        
        <div class="text-xs text-text-muted font-mono flex items-center gap-2">
          <span>🇦🇺</span> Proudly based in Brisbane, Australia
        </div>
      </div>

      <!-- Column 2: Company -->
      <div class="lg:col-span-2 lg:pl-4 space-y-4">
        <h3 class="text-xs uppercase tracking-widest text-text-muted font-mono font-bold">Company</h3>
        <ul class="space-y-2">
          <li><a href="/about" class="text-sm text-text hover:text-accent transition-colors">About Us</a></li>
          <li><a href="/services" class="text-sm text-text hover:text-accent transition-colors">Services</a></li>
          <li><a href="/case-studies" class="text-sm text-text hover:text-accent transition-colors">Case Studies</a></li>
          <li><a href="/blog" class="text-sm text-text hover:text-accent transition-colors">Blog & News</a></li>
          <li><span class="text-sm text-text-faint cursor-not-allowed">Careers (Hiring)</span></li>
        </ul>
      </div>

      <!-- Column 3: Services -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-xs uppercase tracking-widest text-text-muted font-mono font-bold">Expertise</h3>
        <ul class="space-y-2">
          <li><a href="/services/web-design-development" class="text-sm text-text hover:text-accent transition-colors">Web Design & Development</a></li>
          <li><a href="/services/mobile-app-development" class="text-sm text-text hover:text-accent transition-colors">Mobile App Development</a></li>
          <li><a href="/services/ui-ux-design" class="text-sm text-text hover:text-accent transition-colors">UI/UX Design</a></li>
          <li><a href="/services/digital-marketing" class="text-sm text-text hover:text-accent transition-colors">Digital Marketing Solutions</a></li>
          <li><a href="/services/seo-content-services" class="text-sm text-text hover:text-accent transition-colors">Search Engine Optimization</a></li>
          <li><a href="/services/graphics-motion-design" class="text-sm text-text hover:text-accent transition-colors">Graphics & Motion Design</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-xs uppercase tracking-widest text-text-muted font-mono font-bold">Office</h3>
        <ul class="space-y-3 text-sm">
          <li class="text-text-muted">
            123 Eagle St<br />
            Brisbane City QLD 4000, Australia
          </li>
          <li>
            <a href="mailto:info@rayneticsolutions.com.au" class="text-accent hover:underline block font-mono">info@rayneticsolutions.com.au</a>
          </li>
          <li>
            <a href="tel:+61730000000" class="text-text hover:text-accent transition-colors block font-mono">+61 7 3000 0000</a>
          </li>
          <li class="text-xs text-text-muted font-mono">
            Mon - Fri / 9:00 AM - 5:30 PM AEST
          </li>
        </ul>
      </div>

    </div>

    <!-- Divider -->
    <div class="border-t border-border pt-8 mt-8 flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Footer Bottom Left -->
      <div class="text-xs text-text-muted space-y-2 text-center md:text-left">
        <div>
          &copy; {currentYear} Raynetic Solutions Pty Ltd. All rights reserved.
        </div>
      </div>

      <!-- Footer Bottom Center (Legal Links) -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-mono">
        <a href="/privacy-policy" class="text-text-muted hover:text-accent transition-colors">Privacy Policy</a>
        <span class="text-border">|</span>
        <a href="/terms" class="text-text-muted hover:text-accent transition-colors">Terms of Service</a>
        <span class="text-border">|</span>
        <a href="/cookie-policy" class="text-text-muted hover:text-accent transition-colors">Cookie Policy</a>
        <span class="text-border">|</span>
        <!-- Button to show cookie preferences again -->
        <button id="footer-cookie-pref-trigger" class="text-text-muted hover:text-accent transition-colors outline-none cursor-pointer">
          Cookie Preferences
        </button>
      </div>

    </div>
  </div>
</footer>

<script>
  // Add trigger to show cookie banner
  const trigger = document.getElementById('footer-cookie-pref-trigger');
  trigger?.addEventListener('click', () => {
    const banner = document.getElementById('cookie-consent-banner');
    if (banner) {
      banner.style.display = 'block';
      setTimeout(() => {
        banner.style.transform = 'translateY(0)';
        banner.style.opacity = '1';
      }, 50);
    }
  });
</script>
