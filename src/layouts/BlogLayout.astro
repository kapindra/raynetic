---
import BaseLayout from './BaseLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  frontmatter: {
    title: string;
    date: string;
    author: string;
    category: string;
    excerpt: string;
    coverImage: string;
    readTime: string;
    tags?: string[];
  };
  headings: Heading[];
}

const { frontmatter, headings } = Astro.props;
const formattedDate = new Date(frontmatter.date).toLocaleDateString('en-AU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout 
  title={frontmatter.title}
  description={frontmatter.excerpt}
  ogImage={frontmatter.coverImage}
>
  <!-- Hero Section -->
  <section class="relative pt-32 pb-20 border-b border-border">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-surface border border-border rounded-full text-xs text-accent font-mono mb-6">
        <span>{frontmatter.category}</span>
        <span class="w-1 h-1 bg-text-muted rounded-full"></span>
        <span>{frontmatter.readTime}</span>
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
        {frontmatter.title}
      </h1>
      <p class="text-lg text-text-muted mb-8 max-w-2xl mx-auto">
        {frontmatter.excerpt}
      </p>
      <div class="flex items-center justify-center gap-4 text-sm text-text-muted font-mono">
        <span class="text-white font-sans font-medium">{frontmatter.author}</span>
        <span>/</span>
        <span>{formattedDate}</span>
      </div>
    </div>
  </section>

  <!-- Post Body & Sidebar Container -->
  <section class="max-w-7xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Table of Contents Sidebar (Desktop) -->
      <aside class="hidden lg:block lg:col-span-3">
        <div class="sticky top-32 border border-border rounded-2xl p-6 bg-surface/50 backdrop-blur-md">
          <h2 class="text-xs uppercase tracking-widest text-text-muted font-mono mb-4">Table of Contents</h2>
          <nav class="space-y-3">
            {headings.filter(h => h.depth <= 3).map((heading) => (
              <a 
                href={`#${heading.slug}`}
                class={`block text-sm text-text-muted hover:text-accent transition-colors duration-200 pl-${(heading.depth - 2) * 4}`}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Main Content Body -->
      <article class="lg:col-span-9 max-w-3xl mx-auto lg:mx-0 w-full">
        <!-- Cover Image -->
        {frontmatter.coverImage && (
          <div class="rounded-2xl overflow-hidden border border-border mb-12 shadow-card">
            <img 
              src={frontmatter.coverImage} 
              alt={frontmatter.title} 
              class="w-full h-[400px] object-cover"
              fetchpriority="high"
            />
          </div>
        )}

        <!-- Markdown Rendered Slot -->
        <div class="prose max-w-none">
          <slot />
        </div>

        <!-- Share Buttons & Tags -->
        <div class="border-t border-b border-border py-8 my-12 flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="flex flex-wrap gap-2">
            {frontmatter.tags && frontmatter.tags.map((tag) => (
              <span class="px-3 py-1 bg-surface border border-border rounded-full text-xs text-text-muted font-mono">
                #{tag}
              </span>
            ))}
          </div>
          <div class="flex items-center gap-4">
            <span class="text-sm text-text-muted font-mono">Share Article:</span>
            <button 
              id="btn-copy-link" 
              class="p-2 border border-border rounded-lg text-text-muted hover:text-accent hover:border-accent transition-colors"
              title="Copy Link"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
              </svg>
            </button>
            <a 
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="p-2 border border-border rounded-lg text-text-muted hover:text-accent hover:border-accent transition-colors"
              title="Share on LinkedIn"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
            <a 
              href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(frontmatter.title)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="p-2 border border-border rounded-lg text-text-muted hover:text-accent hover:border-accent transition-colors"
              title="Share on Twitter/X"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Author Bio Card -->
        <div class="border border-border rounded-2xl p-8 bg-surface mb-16 flex flex-col md:flex-row gap-6 items-center">
          <div class="w-20 h-20 bg-accent-2/10 border border-accent rounded-full flex items-center justify-center text-accent text-2xl font-bold font-mono">
            {frontmatter.author.split(' ').map(n => n[0]).join('')}
          </div>
          <div class="flex-1 text-center md:text-left">
            <h3 class="text-xl font-bold text-white mb-2">{frontmatter.author}</h3>
            <p class="text-sm text-text-muted">
              Senior Creative Director and strategist at Raynetic Solutions. Overseeing branding, digital applications, and marketing design for organizations across Australia.
            </p>
          </div>
        </div>

        <!-- Call to Action back to Blog -->
        <div class="flex justify-between items-center">
          <a href="/blog" class="inline-flex items-center gap-2 text-accent hover:underline font-mono text-sm">
            ← Back to insights
          </a>
        </div>
      </article>

    </div>
  </section>

  <script>
    const btn = document.getElementById('btn-copy-link');
    if (btn) {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        btn.innerHTML = `<span class="text-xs text-accent font-mono">Copied!</span>`;
        setTimeout(() => {
          btn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
          `;
        }, 2000);
      });
    }
  </script>
</BaseLayout>
